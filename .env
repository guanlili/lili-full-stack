# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:5173
# In production: FRONTEND_HOST=https://your-domain.com

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="My Project"

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,http://localhost:80"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails (optional)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

SENTRY_DSN=

# Port the frontend is exposed on (default 80)
APP_PORT=80
